<resources>
    <!--
        Android automatically picks this file over res/values/themes.xml
        when the system is in dark mode (the "-night" resource qualifier).
        Same style name (Theme.Wayo), different parent/background, so
        nothing else in the manifest needs to change  this fixes the
        light-flash-before-Compose-loads gap without touching AppCompat or
        adding a new dependency.
    -->
    <style name="Theme.Wayo" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background_dark</item>
    </style>
</resources>
